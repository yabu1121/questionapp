@baseUrl = http://localhost:8080
@userId = 1
@questionnaireId = 1
@choiceId = 1
@parentCommentId = 1

### Upsert user setting
PUT {{baseUrl}}/v1/users/{{userId}}/setting
Content-Type: application/json
Accept: application/json

{
  "ui_mode": "dark",
  "timezone": "Asia/Tokyo"
}

### Upsert email notification setting
PUT {{baseUrl}}/v1/users/{{userId}}/notification-settings/email
Content-Type: application/json
Accept: application/json

{
  "is_enabled": true
}
