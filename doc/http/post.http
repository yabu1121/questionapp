@baseUrl = http://localhost:8080
@userId = 1
@questionnaireId = 1
@choiceId = 1
@parentCommentId = 1

### Create language
POST {{baseUrl}}/v1/languages
Content-Type: application/json
Accept: application/json

{
  "code": "ja",
  "name": "Japanese",
  "native_name": "日本語",
  "description": "Japanese language"
}

### Create user
POST {{baseUrl}}/v1/users
Content-Type: application/json
Accept: application/json

{
  "name": "test-user",
  "display_name": "テストユーザー",
  "handle": "test_user",
  "email": "test@example.com",
  "password": "password123",
  "bio": "",
  "avatar_url": "",
  "birthday": "2000-01-01"
}

### Login
POST {{baseUrl}}/v1/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

### Create published questionnaire with choices
POST {{baseUrl}}/v1/questionnaires/published
Content-Type: application/json
Accept: application/json

{
  "created_by": {{userId}},
  "title": "好きなプログラミング言語は？",
  "description": "普段よく使う言語を選んでください",
  "deadline": "2026-12-31T23:59:59+09:00",
  "type": "single_choice",
  "max_choices": 1,
  "language_code": "ja",
  "visibility": "after_vote",
  "choices": [
    {
      "title": "Go"
    },
    {
      "title": "TypeScript"
    },
    {
      "title": "Python"
    }
  ]
}

### Create vote
POST {{baseUrl}}/v1/questionnaires/{{questionnaireId}}/votes
Content-Type: application/json
Accept: application/json

{
  "user_id": {{userId}},
  "choice_ids": [{{choiceId}}]
}

### Create comment
POST {{baseUrl}}/v1/questionnaires/{{questionnaireId}}/comments
Content-Type: application/json
Accept: application/json

{
  "user_id": {{userId}},
  "content": "Goが好きです",
  "parent_comment_id": null
}

### Create reply comment
POST {{baseUrl}}/v1/questionnaires/{{questionnaireId}}/comments
Content-Type: application/json
Accept: application/json

{
  "user_id": {{userId}},
  "content": "このコメントへの返信です",
  "parent_comment_id": {{parentCommentId}}
}

### Create questionnaire like
POST {{baseUrl}}/v1/questionnaires/{{questionnaireId}}/likes
Content-Type: application/json
Accept: application/json

{
  "user_id": {{userId}}
}
